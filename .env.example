# GEMINI_API_KEY: Optional Gemini API key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of this application.
APP_URL="MY_APP_URL"

# Supabase Configuration (supports Next.js, Vite, or standard server env var names from existing ZYRO Retail POS)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server session signing secret (auto-generated fallback used if omitted in development)
SESSION_SECRET=""
