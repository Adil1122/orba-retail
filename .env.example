# GEMINI_API_KEY: Optional Gemini API key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of this application.
APP_URL="MY_APP_URL"

# Supabase Configuration (supports Next.js, Vite, or standard server env var names from existing ZYRO Retail POS)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server session encryption & HMAC signing secret (generate 32+ random bytes in production)
SESSION_SECRET=""

# Temporary Dev/Testing OTP display mode (set to "true" ONLY in development/staging; keep "false" in production)
AUTH_OTP_DEMO_MODE="false"

# Authentication session & OTP policy configuration
AUTH_COOKIE_NAME="zyro_session"
AUTH_SESSION_TTL_HOURS="24"
AUTH_REMEMBER_TTL_DAYS="30"
AUTH_OTP_TTL_MINUTES="10"
AUTH_OTP_MAX_ATTEMPTS="5"

